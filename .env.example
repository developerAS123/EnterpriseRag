# ============================================================
# Enterprise IT Support Agentic RAG Copilot — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── LLM — Groq (free tier) ──────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Web Search — Tavily (1000 req/month free) ───────────────
# Get your key at https://app.tavily.com/
TAVILY_API_KEY=tvly-your_tavily_key_here

# ── Vector Database — Pinecone (Starter plan free) ──────────
# Get your key at https://app.pinecone.io/
PINECONE_API_KEY=pcsk_your_pinecone_key_here
PINECONE_INDEX_NAME=industry-agentic-rag-kb
PINECONE_NAMESPACE=company-kb

# ── Embedding model (local HuggingFace, no API key needed) ──
# all-MiniLM-L6-v2 → 384-dim. Downloaded automatically on first run (~90 MB).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Retrieval settings ───────────────────────────────────────
TOP_K=4
MAX_RETRIES=1

# ── Ingestion settings ───────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=20

# ── Security ─────────────────────────────────────────────────
# Change this to a strong random string before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=change-me-to-a-strong-random-secret

# ── Application ──────────────────────────────────────────────
# Use "production" on Render; "development" locally.
APP_ENV=development
